# Wirtualne środowisko i wyniki budowania
.venv/
build/
dist/
*.egg-info/
# Generowany przez PyInstaller — scripts/build_windows.ps1 buduje z flag CLI,
# nie z tego pliku.
MDTools.spec

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Telegram API ID/Hash MDTools' own builds ship with. Generated by
# scripts/build_windows.ps1 / build_linux.sh from the MDTOOLS_TELEGRAM_API_ID
# / MDTOOLS_TELEGRAM_API_HASH environment variables, and kept locally so a
# dev-mode run works too. NEVER commit it: this repo has a public remote, and
# a credential in git history is effectively permanent -- rewriting history
# still leaves it in forks and caches. See
# app_settings._bundled_telegram_credentials().
src/mdtools/_build_credentials.py

# Lokalna pamięć zgód narzędzia — nic wspólnego z aplikacją.
.claude/

# Systemowe
Thumbs.db
.DS_Store

# UWAGA: src/mdtools/i18n/*.qm NIE są ignorowane, choć są generowane z .ts.
# pyproject.toml deklaruje je jako package-data, a build_windows.ps1 wprost je
# pakuje (--add-data) zamiast przebudowywać — bez nich świeży klon traci
# tłumaczenia, a build wywala się na brakującym pliku.

# Projekty użytkownika. Zapisane domyślnie do Dokumenty/MiniDiscProjects
# (patrz user_paths.py), ale zanim to powstało, okna plików startowały w
# katalogu roboczym procesu — czyli tutaj, gdy aplikację uruchamia się z
# repozytorium. Gdyby kiedyś miał tu trafić projekt przykładowy, dodaj go
# przez `git add -f`.
*.mdproj
